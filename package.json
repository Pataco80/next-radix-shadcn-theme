{
	"name": "next-radix-shadcn-theme",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"refresh": "pnpm clean && pnpm dev",
		"rebuild": "pnpm clean && pnpm build",
		"clean": "rm -rf .next",
		"reset": "pnpm clean && pnpm clean:modules && pnpm install --prefer-offline",
		"clean:modules": "rm -rf node_modules",
		"update-lock": "pnpm install --prefer-offline",
		"install:timeout": "pnpm install --network-timeout 100000",
		"install:registry": "pnpm install --registry=https://registry.npmjs.org/",
		"cache:clean": "pnpm store prune",
		"analyze": "ANALYZE=true next build",
		"check-deps": "depcheck || true"
	},
	"dependencies": {
		"@iamtraction/google-translate": "^2.0.1",
		"@radix-ui/react-slot": "^1.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.479.0",
		"next": "15.2.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss-animate": "^1.0.7",
		"ts-node": "^10.9.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@next/bundle-analyzer": "^15.2.1",
		"@tailwindcss/postcss": "4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"autoprefixer": "^10.4.18",
		"bundle-buddy": "^0.2.2",
		"depcheck": "^1.4.7",
		"eslint": "^9",
		"eslint-config-next": "15.2.1",
		"eslint-config-prettier": "^10.0.2",
		"postcss": "^8.4.35",
		"postcss-import": "^16.0.1",
		"tailwindcss": "^4.0.13",
		"typescript": "^5.8.2"
	}
}
