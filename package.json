{
	"name": "next-radix-theme",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"refresh": "pnpm clean && pnpm dev --turbopack",
		"rebuild": "pnpm clean && pnpm build",
		"clean": "rm -rf .next",
		"reset": "pnpm clean && pnpm clean:modules && pnpm install --prefer-offline",
		"clean:modules": "rm -rf node_modules",
		"update-lock": "pnpm install --prefer-offline"
	},
	"dependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"next": "15.2.1"
	},
	"devDependencies": {
		"typescript": "^5",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@tailwindcss/postcss": "^4",
		"tailwindcss": "^4",
		"eslint": "^9",
		"eslint-config-next": "15.2.1",
		"@eslint/eslintrc": "^3"
	}
}
