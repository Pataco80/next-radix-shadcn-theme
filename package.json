{
	"name": "next-radix-theme",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"refresh": "pnpm clean && pnpm dev --turbopack",
		"rebuild": "pnpm clean && pnpm build",
		"clean": "rm -rf .next",
		"reset": "pnpm clean && pnpm clean:modules && pnpm install --prefer-offline",
		"clean:modules": "rm -rf node_modules",
		"update-lock": "pnpm install --prefer-offline",
		"install:timeout": "pnpm install --network-timeout 100000",
		"install:registry": "pnpm install --registry=https://registry.npmjs.org/",
		"cache:clean": "pnpm store prune",
		"translate:fr": "ts-node scripts/translate-fr.ts",
		"translate:fr:all": "ts-node scripts/translate-fr.ts --all",
		"translate:fr:find": "ts-node scripts/translate-fr.ts --find",
		"translate:en": "ts-node scripts/translate-en.ts",
		"translate:en:all": "ts-node scripts/translate-en.ts --all",
		"translate:en:find": "ts-node scripts/translate-en.ts --find"
	},
	"dependencies": {
		"@iamtraction/google-translate": "^2.0.1",
		"next": "15.2.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"ts-node": "^10.9.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "15.2.1",
		"eslint-config-prettier": "^10.0.2",
		"tailwindcss": "^4",
		"typescript": "^5.8.2"
	}
}
